# Required for `console` mode (local mic/speaker test, no LiveKit account
# needed): authenticates Gemini Live's RealtimeModel, the full audio
# pipeline (STT+LLM+TTS in one full-duplex session -- see agent.py).
GOOGLE_API_KEY=
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# NOT the live audio path -- used by the offline router-eval harness and by
# AckGenerator's simple_lookup answer only (see ack.py, gemini_client.py,
# router_eval.py). At least ONE of these two is required, not both.
# Anthropic (Claude Haiku) is the designed default when present; Gemini is
# the fully-supported fallback for when it isn't. If both are set,
# Anthropic wins unless LLM_PROVIDER says otherwise.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# LLM_PROVIDER=gemini

# Defaults to mock-agent-backend's own default port -- override once real
# CollectiveOS exists.
COLLECTIVEOS_WS_URL=ws://localhost:8000/v1/ws

# The session stays silent and takes no action on anything until this
# phrase is heard (case-insensitive, whole-phrase match, tolerant of a
# comma inserted between words). Once heard, stays awake until SLEEP_WORD
# is heard.
# WAKE_WORD=hey voiceos
# SLEEP_WORD=voiceos go to sleep

# Unset means session state and per-user rate limiting both live in-process
# only (fine for a single instance / local dev). Set to share both across
# workers and survive restarts (session_store.py, rate_limiter.py).
# REDIS_URL=redis://localhost:6379/0

# Only needed for `dev`/`start` (a real LiveKit room). WorkerOptions reads
# these itself -- not read by our own config.py.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional. Unset means no error tracking, not a startup failure -- read
# directly in main(), not through Settings(), so --help keeps working with
# no env vars set at all.
SENTRY_DSN=

# Optional LLM call tracing (router.py's classify, ack.py's simple_lookup
# answer -- see their @traceable decorators). Read directly by the
# langsmith package itself, not through Settings() or any explicit init
# call -- unset means those calls just run normally, untraced. Confirmed
# live that a set-but-invalid LANGCHAIN_API_KEY only logs a warning and
# doesn't affect the call's actual return value.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
